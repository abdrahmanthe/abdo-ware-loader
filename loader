local Players
local deadline = os.clock() + 30
while os.clock() < deadline do
    task.wait(0.2)
    local ok, svc = pcall(function() return game:GetService("Players") end)
    if ok and svc then
        local lpOk, lp = pcall(function() return svc.LocalPlayer end)
        if lpOk and lp then
            Players = svc
            break
        end
    end
end

if not Players then
    warn("Abdo-Ware Loader: Players service unavailable. DataModel = " .. tostring(game.ClassName))
    return
end

local GameRegistry = {
    [10200395747] = "https://raw.githubusercontent.com/abdrahmanthe/abdo-ware-growagarden2/refs/heads/main/gag2",
    [6504986360]  = "https://raw.githubusercontent.com/abdrahmanthe/abdo-ware-bubblegumsimulator/refs/heads/main/bgs",
    [372226183]   = "https://raw.githubusercontent.com/abdrahmanthe/abdo-ware-fleethefacillty/refs/heads/main/ftf",
    [6035872082]  = "https://raw.githubusercontent.com/abdrahmanthe/abdo-ware-rivals/refs/heads/main/Rivals",
}

local GameNames = {
    [10200395747] = "Grow a Garden 2",
    [6504986360]  = "Bubble Gum Simulator",
    [372226183]   = "Flee the Facility",
    [6035872082]  = "Rivals",
}

local currentGameId = game.GameId
if currentGameId == 0 then
    local ok, resp = pcall(function()
        return game:HttpGet("https://apis.roblox.com/universes/v1/places/" .. game.PlaceId .. "/universe")
    end)
    if ok then
        currentGameId = tonumber(resp:match('"universeId":(%d+)')) or 0
    end
end

local scriptUrl = GameRegistry[currentGameId]
local gameName  = GameNames[currentGameId] or "Unknown Game"

if not scriptUrl then
    warn("Abdo-Ware Loader: Unsupported game. GameId = " .. tostring(currentGameId))
    return
end

local success, response = pcall(function() return game:HttpGet(scriptUrl) end)
if not success or not response or response == "" then
    warn("Abdo-Ware Loader: Download failed. " .. scriptUrl)
    return
end

local scriptFunction, compileError = loadstring(response)
if not scriptFunction then
    warn("Abdo-Ware Loader: Compile failed. " .. tostring(compileError))
    return
end

local execSuccess, execError = pcall(scriptFunction)
if not execSuccess then
    warn("Abdo-Ware Loader: Runtime error. " .. tostring(execError))
else
    print("Abdo-Ware Loader: " .. gameName .. " loaded.")
end
