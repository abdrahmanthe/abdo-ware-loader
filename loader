-- ===================================================================
--  ABDO-WARE 4-GAME UNIVERSAL LOADER (v2 — UGC-safe)
-- ===================================================================

-- Robust wait: never touch game.Players directly, never error on UGC DataModel
local Players
local deadline = os.clock() + 30
while os.clock() < deadline do
    task.wait(0.2)
    local ok, svc = pcall(function() return game:GetService("Players") end)
    if ok and svc then
        local lpOk, lp = pcall(function() return svc.LocalPlayer end)
        if lpOk and lp then
            Players = svc
            break
        end
    end
end

if not Players then
    warn("======================================")
    warn("Abdo-Ware Loader: Players service unavailable.")
    warn("DataModel ClassName = " .. tostring(game.ClassName))
    warn("You're in a UGC world / menu / loading screen.")
    warn("Join one of the supported games and re-run the loader.")
    warn("======================================")
    return
end

-- ===================================================================
--  CONFIG
-- ===================================================================
local GameRegistry = {
    [10200395747] = "https://raw.githubusercontent.com/abdrahmanthe/abdo-ware-growagarden2/refs/heads/main/gag2",
    [6504986360]  = "https://raw.githubusercontent.com/abdrahmanthe/abdo-ware-bubblegumsimulator/refs/heads/main/bgs",
    [372226183]   = "https://raw.githubusercontent.com/abdrahmanthe/abdo-ware-fleethefacillty/refs/heads/main/ftf",
    [6035872082]  = "https://raw.githubusercontent.com/abdrahmanthe/abdo-ware-rivals/refs/heads/main/Rivals",
}

local GameNames = {
    [10200395747] = "Grow a Garden 2",
    [6504986360]  = "Bubble Gum Simulator",
    [372226183]   = "Flee the Facility",
    [6035872082]  = "Rivals",
}
-- ===================================================================

-- Resolve GameId (with API fallback in case game.GameId returns 0)
local currentGameId = game.GameId
if currentGameId == 0 then
    local ok, resp = pcall(function()
        return game:HttpGet("https://apis.roblox.com/universes/v1/places/" .. game.PlaceId .. "/universe")
    end)
    if ok then
        currentGameId = tonumber(resp:match('"universeId":(%d+)')) or 0
    end
end

local scriptUrl = GameRegistry[currentGameId]
local gameName  = GameNames[currentGameId] or "Unknown Game"

print("======================================")
print("Abdo-Ware Loader: GameId = " .. tostring(currentGameId))
print("Abdo-Ware Loader: Game   = " .. gameName)
print("======================================")

if not scriptUrl then
    warn("Abdo-Ware Loader: This game is NOT supported. (GameId: " .. tostring(currentGameId) .. ")")
    return
end

print("Abdo-Ware Loader: Downloading " .. gameName .. " script...")
local success, response = pcall(function()
    return game:HttpGet(scriptUrl)
end)

if not success or not response or response == "" then
    warn("Abdo-Ware Loader: Failed to download script from:\n" .. scriptUrl)
    return
end

local scriptFunction, compileError = loadstring(response)
if not scriptFunction then
    warn("Abdo-Ware Loader: Failed to compile script: " .. tostring(compileError))
    return
end

print("Abdo-Ware Loader: Executing...")
local execSuccess, execError = pcall(scriptFunction)
if not execSuccess then
    warn("Abdo-Ware Loader: Script error: " .. tostring(execError))
else
    print("Abdo-Ware Loader:  " .. gameName .. " loaded successfully!")
end
